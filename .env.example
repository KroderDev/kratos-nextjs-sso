# Public application name and 1-2 character footer mark/initials.
# Leave both logo paths empty to render no header brand.
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_MARK=
# Public paths under /public. Set only the light path to reuse it in both themes.
NEXT_PUBLIC_BRAND_LOGO_LIGHT=
NEXT_PUBLIC_BRAND_LOGO_DARK=

# Optional custom favicon paths under /public. Leave empty to fall back to app/favicon.ico.
# When NEXT_PUBLIC_BRAND_FAVICON_DARK is set, automatically switches based on OS dark theme.
NEXT_PUBLIC_BRAND_FAVICON_LIGHT=
NEXT_PUBLIC_BRAND_FAVICON_DARK=


# Public application URL used for logout return URLs and Ory project configuration.
# Required when Ory is configured in production; keep it optional for the unconfigured smoke state.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ory Network SDK URL or another compatible public identity API.
NEXT_PUBLIC_ORY_SDK_URL=

# Optional canonical provider URL used when the SDK URL is a proxy or local endpoint.
NEXT_PUBLIC_ORY_CANONICAL_URL=

# Public OAuth provider origins included in the CSP form-action allowlist.
# Separate multiple origins with commas or whitespace, for example:
# https://accounts.google.com,https://github.com
NEXT_PUBLIC_ORY_OAUTH_ORIGINS=

# Additional origins allowed to receive Ory form submissions and their redirects.
# Include OAuth client application origins here, without paths or wildcards.
NEXT_PUBLIC_ORY_FORM_ACTION_ORIGINS=

# Optional provider project label. Defaults to NEXT_PUBLIC_BRAND_NAME (neutral default: Kratos SSO).
NEXT_PUBLIC_ORY_PROJECT_NAME=

# Required when proxying an Ory Network project through the application.
# Keep this server-only and never prefix it with NEXT_PUBLIC_.
ORY_PROJECT_API_TOKEN=

# Set to "false" to hide the "Create an account" link on the login page.
# Defaults to true when unset.
NEXT_PUBLIC_ORY_REGISTRATION_ENABLED=true

# Controls whether accepted OAuth consent is remembered for future requests.
# Supported values: always (default), prompt, or never.
ORY_CONSENT_REMEMBER_MODE=always
