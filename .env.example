# Optional explicit application origin used for logout return URLs and Ory project configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ory Network SDK URL or the public URL of a local Kratos frontend API.
NEXT_PUBLIC_ORY_SDK_URL=

# Optional project label shown by Ory and the application shell.
NEXT_PUBLIC_ORY_PROJECT_NAME=Kroder Identity

# Required when proxying an Ory Network project through the application.
# Keep this server-only and never prefix it with NEXT_PUBLIC_.
ORY_PROJECT_API_TOKEN=
